# Copy this file to backend/.env and fill in real values.
#
#     cp .env.example backend/.env
#
# NEVER commit backend/.env — it is gitignored on purpose.
# After editing, verify with:  make check-llm

# --- Database ---
DATABASE_URL=sqlite:///./attackdna.db

# --- LLM (optional) ---
# ATTACKDNA runs fully offline without a key: every stage still executes and
# extraction is deterministic. A key adds three things:
#   • a written narrative summary and root cause in the Attack DNA
#   • sharper wording in the simulation injects
#   • grounded natural-language answers in "Ask the memory" (plus Arabic questions)
#
# Either provider works. Paste one key — the provider is inferred from its prefix.
#
#   Google Gemini   AIza...      free tier    https://aistudio.google.com/apikey
#   Anthropic Claude sk-ant-...  pay as you go https://console.anthropic.com
LLM_API_KEY=

# auto = infer from the key prefix. Set to "gemini" or "anthropic" to force it.
LLM_PROVIDER=auto

# Leave empty to use the selected provider's default model.
#   Gemini    e.g. gemini-2.5-flash
#   Anthropic e.g. claude-opus-5
# If the model name is wrong, `make check-llm` lists the ones your key can use.
LLM_MODEL=

# --- Vector memory ---
# sentence-transformers model used to embed Attack DNA.
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_DIR=./data/chroma

# --- Retrieval tuning ---
SIMILARITY_TOP_K=5
SIMILARITY_THRESHOLD=0.25
