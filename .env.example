# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env — it is gitignored on purpose.

# --- Database ---
DATABASE_URL=sqlite:///./attackdna.db

# --- LLM (optional) ---
# ATTACKDNA works fully offline without a key: it falls back to the
# deterministic rule-based extractor. Set a key to enable richer extraction.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# --- Vector memory ---
# sentence-transformers model used to embed Attack DNA.
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_DIR=./data/chroma

# --- Retrieval tuning ---
SIMILARITY_TOP_K=5
SIMILARITY_THRESHOLD=0.25
