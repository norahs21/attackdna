# Copy this file to backend/.env and fill in real values.
#
#     cp .env.example backend/.env
#
# NEVER commit backend/.env — it is gitignored on purpose.
# After editing, verify with:  make check-llm

# --- Database ---
DATABASE_URL=sqlite:///./attackdna.db

# --- LLM (optional) ---
# ATTACKDNA runs fully offline without a key: every stage still executes and
# extraction is deterministic. A key adds three things:
#   • a written narrative summary and root cause in the Attack DNA
#   • sharper wording in the simulation injects
#   • grounded natural-language answers in "Ask the memory" (plus Arabic questions)
#
# Get a key from https://console.anthropic.com  (format: sk-ant-...)
# Cost for two weeks of testing and a demo is a few US dollars.
LLM_API_KEY=
LLM_MODEL=claude-opus-5

# --- Vector memory ---
# sentence-transformers model used to embed Attack DNA.
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_DIR=./data/chroma

# --- Retrieval tuning ---
SIMILARITY_TOP_K=5
SIMILARITY_THRESHOLD=0.25
